# Copy to .env and fill in. Never commit .env.

# --- Telegram ---------------------------------------------------------------
# Token from @BotFather.
BOT_TOKEN=
# Optional proxy for the Telegram API; leave empty for direct access.
PROXY_URL=
# Telegram id of the first manager, usually the owner: this account becomes a
# manager on its first /start (spec §4.1).
OWNER_TELEGRAM_ID=

# --- Planfix ----------------------------------------------------------------
# Account address, including the scheme, e.g. https://acme.planfix.ru
PLANFIX_ACCOUNT=
# REST API token issued for the "Payback" robot (planfix-notes.md §8).
PLANFIX_API_TOKEN=
# Id of the "Расход" object.
PLANFIX_OBJECT_ID=

# Ids of the custom task fields making up the expense card (spec §6).
# Discover candidates: make planfix-ids  (needs ACCOUNT, API_TOKEN, OBJECT_ID).
PLANFIX_FIELD_AMOUNT=
PLANFIX_FIELD_PURCHASE_DATE=
PLANFIX_FIELD_CATEGORY=
PLANFIX_FIELD_DIRECTION=
PLANFIX_FIELD_EMPLOYEE=
PLANFIX_FIELD_FN=
PLANFIX_FIELD_FD=
PLANFIX_FIELD_FP=
PLANFIX_FIELD_NO_RECEIPT=
PLANFIX_FIELD_PAYMENT_DATE=

# Ids of the seven statuses of the "Расход" object (spec §5). Ids, not names:
# accounts rename statuses, and the bot matches on id everywhere.
PLANFIX_STATUS_PENDING=
PLANFIX_STATUS_CLARIFICATION=
PLANFIX_STATUS_APPROVED=
PLANFIX_STATUS_REJECTED=
PLANFIX_STATUS_NEEDS_REVISION=
PLANFIX_STATUS_TO_PAY=
PLANFIX_STATUS_REIMBURSED=

# --- Service ----------------------------------------------------------------
# Shared secret checked in the body of incoming Planfix webhooks (spec §7).
WEBHOOK_SECRET=
# sqlite+aiosqlite:///./payback.db for local `make run`.
# docker compose overrides this to postgresql+asyncpg://payback:payback@db:5432/payback.
DATABASE_URL=sqlite+aiosqlite:///./payback.db
# Public hostname for Caddy / Let's Encrypt (required for docker compose).
DOMAIN=yourbot.duckdns.org
# Prefer secrets outside the git workspace:
#   export PAYBACK_ENV_FILE=$HOME/.config/payback/env

# Validation limits (spec §4.2.2).
MAX_AMOUNT=100000
MAX_RECEIPT_AGE_DAYS=90
# Allow expenses with no cash receipt (spec §4.2.7).
ALLOW_NO_RECEIPT=true
# Cap for receipt-less expenses; empty means no cap.
NO_RECEIPT_MAX_AMOUNT=
# Enables /as for role switching while testing. Off in production.
# When true, a dead Planfix trial falls back to FakePlanfix so the bot still starts.
DEV_MODE=false
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
